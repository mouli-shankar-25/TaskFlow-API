# TaskFlow API Configuration
APP_ENV=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/taskflow
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/taskflow

# Security / JWT
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
